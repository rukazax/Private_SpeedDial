{
  "version": "6.12.1",
  "date": "2026-11-27",
  "testedOn": "Edge 158.0.4370.45, Windows 10.0.26300",
  "method": "isolated Edge profile loaded with the unpacked build; checks executed over the DevTools protocol on the real bookmark set",
  "dataset": {
    "tiles": 1936,
    "folders": 44,
    "topLevelFolders": 10,
    "notes": 13,
    "source": "owner's own speed dial export"
  },
  "checks": {
    "manifestVersion": "6.12.1",
    "tagsFunctionality": "removed",
    "tilesWithTagsAfterStart": 0,
    "folderBarVisibleByDefault": true,
    "showFoldersPersistsAfterReload": true,
    "subfolderRowPresent": true,
    "subfolderRowHiddenOnAll": true,
    "subfolderRowShownForGroup": {
      "group": "Серверы и сети",
      "subfolders": 5
    },
    "subfolderRowOnSubfolder": "shows siblings, active item highlighted",
    "stickyRows": {
      "scrollTop": 660,
      "firstRowTopPx": 121,
      "secondRowTopPx": 165,
      "gapPx": 44,
      "firstRowSticky": true,
      "secondRowSticky": true
    },
    "search": {
      "folderOperator": 125,
      "typeOperator": 70,
      "tagsOperator": "removed"
    },
    "screenshotBackground": {
      "provider": "mShots (s0.wp.com)",
      "entryPoints": ["tile context menu", "tile dialog buttons", "bulk selection", "tools panel"],
      "sizes": ["480x320", "600x400", "1200x800"],
      "cacheBustOnRefresh": true,
      "clearAction": true
    },
    "cleanup": {
      "duplicateDetection": "normalized URL (scheme, www, trailing slash, UTM)",
      "junkTitles": true,
      "emptyFolders": true,
      "corruptedNames": true
    },
    "backup": {
      "exportJson": true,
      "restoreModes": ["merge", "replace"]
    },
    "sanitizer": [
      "broken folder names",
      "duplicate folder ids",
      "lost parents",
      "orphan tiles",
      "cycles in folder tree"
    ]
  },
  "limits": {
    "localization": "new UI strings are Russian only; 13-language translation is next",
    "storeInstall": "Web Store builds verify content hashes, so an in-place patched copy is rejected; the tested build runs as an unpacked extension in a dedicated profile",
    "screenshotDelay": "first frame is generated by the external service and may show a placeholder for a few seconds",
    "encryptionKey": "still stored in chrome.storage.sync; moving it changes the multi-device scenario"
  }
}
