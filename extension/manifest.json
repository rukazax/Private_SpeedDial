{
  "manifest_version": 3,
  "name": "Private SpeedDial",
  "version": "6.10.3",
  "description": "Приватный быстрый набор закладок с мульти-девайс синхронизацией, шифрованием и вложенными папками",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms",
    "bookmarks",
    "history",
    "contextMenus",
    "windows"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_icon": "icons/icon48.png",
    "default_title": "Private SpeedDial",
    "default_popup": "popup.html"
  },
  "commands": {
    "open-speed-dial": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Открыть Private SpeedDial"
    },
    "sync-now": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Синхронизировать (объединить)"
    },
    "search-tiles": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Поиск по плиткам"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "parser-worker.js",
        "icons/*",
        "backgrounds/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "minimum_chrome_version": "111",
  "homepage_url": "https://github.com/rukazax/Private_SpeedDial"
}
